# Copy to .env for local dev. On Railway, set these in the Variables tab.
# NEVER commit the real .env — it is gitignored.

# ---- core ----
DATABASE_PATH=./data/nfl.db
DATA_DIR=./data
ARTIFACT_DIR=./data/artifacts
ENV=local                          # local | production
LOG_LEVEL=INFO
TZ=America/New_York

# ---- external APIs ----
ANTHROPIC_API_KEY=
ODDS_API_KEY=

# ---- auth ----
JWT_SECRET_KEY=                    # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=43200

# ---- twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- admin bootstrap ----
ADMIN_PHONE=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- budgets ----
ODDS_MONTHLY_CREDIT_BUDGET=100000
AI_MONTHLY_BUDGET_USD=150

# ---- feature flags: staged rollout ----
PUBLISH_MODEL_PICKS=false          # false = dark launch (models run, subscribers don't see)
ENABLE_PROPS=false                 # flip ~Week 4
ENABLE_SIMULATOR=false             # flip ~Week 8
ENABLE_AI_REDTEAM=true
ENABLE_SMS=false                   # keep false until you've watched a full dry run

# ---- betting params ----
MIN_EDGE_PCT=5.0                   # lower as CLV validates
KELLY_FRACTION=0.125               # raise to 0.25 once proven
MAX_BET_PCT_BANKROLL=2.0
SHARP_BOOKS=pinnacle
DEVIG_METHOD=power                 # power | shin | multiplicative | additive

# ---- season ----
CURRENT_SEASON=2026
